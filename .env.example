# --- TikTok for Developers app credentials ---
# Create an app at https://developers.tiktok.com, add Login Kit + Content Posting API,
# request the video.upload scope, and register the redirect URI below.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://tt-media.yourbrand.com/oauth/callback
# Optional override; default is "user.info.basic,video.upload"
# TIKTOK_SCOPES=user.info.basic,video.upload

# --- Cloudflare R2 (S3-compatible) image hosting ---
# Account ID is in the Cloudflare dashboard URL / R2 overview.
R2_ACCOUNT_ID=
# Create an R2 API token (S3 credentials) with read/write on the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tiktok-slideshows
# The TikTok-verified custom domain mapped to the bucket (no trailing slash).
R2_PUBLIC_BASE_URL=https://tt-media.yourbrand.com

# --- Optional: where to persist OAuth tokens (default: ~/.tiktok_slideshow_mcp/tokens.json) ---
# TOKEN_STORE_PATH=
